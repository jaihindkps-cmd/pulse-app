rules_version = '2';
// Pulse security rules. Saari suraksha yahin se aati hai: client par bharosa nahi kiya jaata.
service cloud.firestore {
  match /databases/{database}/documents {

    function loggedIn() { return request.auth != null; }
    // Asli insaan ka saboot: email verify hona zaroori (link par click). Bina verify ke sirf apni profile ban/dikh sakti hai.
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function me() { return request.auth.uid; }
    // Creator (admin): sirf ye verified email. Isse badalna ho to yahi line badlo.
    function isAdmin() { return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email == 'jaihindkps@gmail.com'; }
    function myMode() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('mode', 'friends'); }
    function notBanned() { return !exists(/databases/$(database)/documents/bans/$(request.auth.uid)); }
    function inPair(id) { return me() in id.split('_'); }
    function otherOf(id) { return id.split('_')[0] == me() ? id.split('_')[1] : id.split('_')[0]; }
    function swipeLike(a, b) {
      return exists(/databases/$(database)/documents/swipes/$(a + '_' + b))
        && get(/databases/$(database)/documents/swipes/$(a + '_' + b)).data.kind == 'like';
    }
    function isBlocked(a, b) { return exists(/databases/$(database)/documents/blocks/$(a + '_' + b)); }
    // Gender is required for every new profile (client-side check could be bypassed via devtools —
    // this is the server-side (rules) enforcement so no one can create a profile without it).
    function genderOkFor(data) { return data.get('gender', '').size() > 0; }
    // For edits to an existing profile: either gender is (still) set, or the account predates this
    // requirement and never had a gender set — don't lock such users out of editing the rest of their profile.
    function genderOkForUpdate(data, old) { return genderOkFor(data) || old.get('gender', '').size() == 0; }

    // Profile: sab logged-in log dekh sakte hain, sirf apni badal sakte hain. 18+ zaroori.
    match /users/{uid} {
      allow read: if loggedIn() && (uid == me() || signedIn());
      allow create: if loggedIn() && uid == me()
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.age is number && request.resource.data.age >= 18 && request.resource.data.age <= 99
        && request.resource.data.get('city', '').size() <= 40
        && request.resource.data.get('work', '').size() <= 60
        && request.resource.data.get('about', '').size() <= 300
        && genderOkFor(request.resource.data);
      // Normal self-edit (full profile, own uid only) OR admin flipping ONLY the verified/
      // verifyPending flags on SOMEONE ELSE's doc (Identity verification Approve/Reject,
      // and Members panel Ban/Premium never touch this collection at all).
      allow update: if loggedIn() && (
        (uid == me()
          && request.resource.data.age == resource.data.age
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
          && request.resource.data.get('city', '').size() <= 40
          && request.resource.data.get('work', '').size() <= 60
          && request.resource.data.get('about', '').size() <= 300
          && request.resource.data.get('photo', '').size() <= 45000
          && request.resource.data.get('mode', 'friends') in ['friends', 'dating', 'marriage', 'jobseeker', 'recruiter']
          && genderOkForUpdate(request.resource.data, resource.data)
          && request.resource.data.get('skills', '').size() <= 200 && request.resource.data.get('resume', '').size() <= 200
          && request.resource.data.get('company', '').size() <= 100 && request.resource.data.get('cabout', '').size() <= 300
          && request.resource.data.get('csite', '').size() <= 200 && request.resource.data.get('cvName', '').size() <= 100 && request.resource.data.get('role', '').size() <= 100
          && request.resource.data.get('desig', '').size() <= 100 && request.resource.data.get('community', '').size() <= 100
          && request.resource.data.get('religion', '').size() <= 60 && request.resource.data.get('prefCity', '').size() <= 100
          && (request.resource.data.get('verified', false) == resource.data.get('verified', false) || isAdmin())
          && (request.resource.data.get('verifyPending', false) == true || request.resource.data.get('verifyPending', false) == resource.data.get('verifyPending', false) || isAdmin()))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified', 'verifyPending']))
      );
      allow delete: if loggedIn() && uid == me();

      // Saathi AI ki baatein: sirf apni.
      match /saathi/{id} {
        allow read: if signedIn() && uid == me();
        allow create: if signedIn() && uid == me() && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
        allow delete: if loggedIn() && uid == me();
      }
    }

    // Nearby: sirf wahi dikhta hai jisne khud presence doc banaya (opt-in). Location mota-mota (rounded).
    // Doosron ki location wahi padh sakta hai jisne khud bhi share ki ho (do-tarfa opt-in).
    match /presence/{uid} {
      allow read: if signedIn() && (uid == me() || exists(/databases/$(database)/documents/presence/$(me())));
      allow create, update: if signedIn() && uid == me()
        && request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180;
      allow delete: if signedIn() && uid == me();
    }

    // Status/Stories: 24-ghante ki ephemeral post, sirf apne "mode" (friends/dating/marriage/
    // jobseeker/recruiter) ke logon ko dikhti hai — client query + ye rule dono isko lagu karte hain.
    // Purani (24hr se zyada) stories khud query se chhup jaati hain, delete karna zaroori nahi.
    match /stories/{id} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.mode == myMode();
      allow create: if signedIn() && notBanned() && request.resource.data.uid == me()
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.mode == myMode()
        && request.resource.data.get('text', '').size() <= 150
        && request.resource.data.get('photo', '').size() <= 400000
        && (request.resource.data.get('text', '').size() > 0 || request.resource.data.get('photo', '').size() > 0);
      allow delete: if signedIn() && (resource.data.uid == me() || isAdmin());
    }

    // Feed
    match /posts/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && notBanned() && request.resource.data.uid == me()
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && request.resource.data.likedBy.size() == 0;
      // sirf apna like jodna ya hatana
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
        && request.resource.data.likedBy.toSet().difference(resource.data.likedBy.toSet())
             .union(resource.data.likedBy.toSet().difference(request.resource.data.likedBy.toSet())).hasOnly([me()]);
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Swipe: id = "<from>_<to>". Sirf apna swipe likh sakte ho; apna ya mujh par kiya hua padh sakte ho.
    match /swipes/{id} {
      allow get: if signedIn() && inPair(id);
      allow list: if signedIn() && resource.data.from == me();
      allow create, update: if signedIn() && request.resource.data.from == me()
        && request.resource.data.to != me()
        && id == me() + '_' + request.resource.data.to
        && request.resource.data.kind in ['like', 'pass'];
    }

    // Match: id = "<chhota uid>_<bada uid>". Tabhi banta hai jab DONO ne like kiya ho.
    match /matches/{mid} {
      allow get: if signedIn() && inPair(mid);
      allow list: if signedIn() && me() in resource.data.users;
      allow create: if signedIn()
        && request.resource.data.users.size() == 2
        && me() in request.resource.data.users
        && request.resource.data.users[0] < request.resource.data.users[1]
        && mid == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && swipeLike(request.resource.data.users[0], request.resource.data.users[1])
        && swipeLike(request.resource.data.users[1], request.resource.data.users[0]);
      allow update: if signedIn() && me() in resource.data.users
        // sirf aakhri message ki jaankari, ya apna "likh raha hoon" / "dekh liya" nishaan
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastText', 'lastAt', 'lastFrom', 'typing_' + me(), 'seen_' + me()])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastText', 'lastAt', 'lastFrom'])
            || request.resource.data.lastFrom == me());

      // Messages: sirf match ke dono log, aur koi block na kare.
      match /messages/{msgId} {
        allow read: if signedIn() && inPair(mid);
        allow create: if signedIn() && inPair(mid)
          && notBanned() && request.resource.data.from == me()
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && exists(/databases/$(database)/documents/matches/$(mid))
          && !isBlocked(me(), otherOf(mid)) && !isBlocked(otherOf(mid), me());
      }
    }

    // Block: apna block banao/hatao/dekho.
    match /blocks/{id} {
      allow get: if signedIn() && id.split('_')[0] == me();
      allow list: if signedIn() && resource.data.blocker == me();
      allow create: if signedIn() && request.resource.data.blocker == me()
        && id == me() + '_' + request.resource.data.blocked && request.resource.data.blocked != me();
      allow delete: if signedIn() && id.split('_')[0] == me();
    }

    // Report: likh sakte ho, padh nahi (sirf admin console me dikhti hain).
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.from == me()
        && request.resource.data.get('reason', '').size() <= 200;
      // Creator sirf reports padh sakta hai (aur kuch nahi).
      allow read, delete: if isAdmin();
    }

    // Ban: sirf creator likhta hai; user sirf apni ban-sthiti dekh sakta hai.
    match /bans/{uid} {
      allow get: if signedIn() && (uid == me() || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Bhajan Room: code (doc id) jaanne wala hi jud sakta hai. List band. Chat sirf members ke liye.
    match /rooms/{rid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && notBanned() && request.resource.data.host == me()
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.items is list && request.resource.data.items.size() <= 80
        && request.resource.data.members == [me()];
      allow update: if signedIn() && notBanned() && (
        (resource.data.host == me() && request.resource.data.host == me())
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'flowers', 'updatedAt'])
            && request.resource.data.members.size() <= 12 && me() in request.resource.data.members));
      allow delete: if signedIn() && resource.data.host == me();
      match /msgs/{mid} {
        allow read: if signedIn() && me() in get(/databases/$(database)/documents/rooms/$(rid)).data.members;
        allow create: if signedIn() && notBanned() && me() in get(/databases/$(database)/documents/rooms/$(rid)).data.members
          && request.resource.data.from == me()
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200;
      }
    }

    // Jobs: recruiter apni job likhta/badalta/hatata hai. Sab verified log padh sakte hain.
    match /jobs/{jid} {
      allow read: if signedIn();
      allow create: if signedIn() && notBanned() && request.resource.data.rid == me() && myMode() == 'recruiter'
        && request.resource.data.get('status', 'open') in ['open', 'closed'] && request.resource.data.get('skills', '').size() <= 120
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.get('desc', '').size() <= 1500 && request.resource.data.get('salary', '').size() <= 40 && request.resource.data.get('company', '').size() <= 60;
      allow update: if signedIn() && resource.data.rid == me() && request.resource.data.rid == me()
        && request.resource.data.get('status', 'open') in ['open', 'closed']
        && request.resource.data.title is string && request.resource.data.title.size() <= 80;
      allow delete: if signedIn() && resource.data.rid == me();
    }

    // Applications: id = "<jobId>_<seekerUid>" (ek job par ek hi baar). Sirf wo seeker aur wahi recruiter dekh sakte hain.
    match /applications/{aid} {
      allow get: if signedIn() && (resource.data.seeker == me() || resource.data.rid == me());
      allow list: if signedIn() && (resource.data.seeker == me() || resource.data.rid == me());
      allow create: if signedIn() && notBanned()
        && exists(/databases/$(database)/documents/jobs/$(request.resource.data.jid))
        && get(/databases/$(database)/documents/jobs/$(request.resource.data.jid)).data.rid == request.resource.data.rid
        && aid == request.resource.data.jid + '_' + request.resource.data.seeker
        && get(/databases/$(database)/documents/jobs/$(request.resource.data.jid)).data.get('status', 'open') != 'closed'
        && ((request.resource.data.seeker == me() && request.resource.data.status == 'applied' && myMode() == 'jobseeker')
            || (request.resource.data.rid == me() && request.resource.data.status == 'invited' && myMode() == 'recruiter'));
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && ((resource.data.rid == me() && request.resource.data.status in ['shortlisted', 'rejected', 'hired', 'invited'])
            || (resource.data.seeker == me() && ((resource.data.status == 'invited' && request.resource.data.status in ['applied', 'declined']) || request.resource.data.status == 'withdrawn')));
      match /cv/{f} {
        allow read: if signedIn() && (get(/databases/$(database)/documents/applications/$(aid)).data.seeker == me() || get(/databases/$(database)/documents/applications/$(aid)).data.rid == me());
        allow write: if signedIn() && notBanned() && get(/databases/$(database)/documents/applications/$(aid)).data.seeker == me()
          && request.resource.data.get('data', '').size() <= 820000;
      }
      match /msgs/{m} {
        allow read: if signedIn() && (get(/databases/$(database)/documents/applications/$(aid)).data.seeker == me() || get(/databases/$(database)/documents/applications/$(aid)).data.rid == me());
        allow create: if signedIn() && notBanned() && request.resource.data.from == me()
          && (get(/databases/$(database)/documents/applications/$(aid)).data.seeker == me() || get(/databases/$(database)/documents/applications/$(aid)).data.rid == me())
          && get(/databases/$(database)/documents/applications/$(aid)).data.status != 'rejected'
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
      }
    }

    // CV: sirf apna. Apply karte waqt copy applications/{aid}/cv me jati hai (sirf wo do log).
    match /resumes/{uid} {
      allow read, write: if signedIn() && uid == me() && notBanned()
        && (request.method == 'delete' || (request.resource.data.get('data', '').size() <= 820000 && request.resource.data.get('name', '').size() <= 100));
    }
    // Phone number: sirf maalik; dusra tabhi padh sakta hai jab maalik ne approve kiya.
    match /contacts/{uid} {
      allow read: if signedIn() && (uid == me() || get(/databases/$(database)/documents/contactReqs/$(uid + '_' + me())).data.get('status', '') == 'approved');
      allow write: if signedIn() && uid == me() && notBanned()
        && (request.method == 'delete' || (request.resource.data.phone is string && request.resource.data.phone.size() >= 10 && request.resource.data.phone.size() <= 16));
    }
    match /contactReqs/{rid} {
      allow get: if signedIn() && me() in rid.split('_');
      allow list: if signedIn() && (resource.data.owner == me() || resource.data.requester == me());
      allow create: if signedIn() && notBanned() && request.resource.data.requester == me()
        && rid == request.resource.data.owner + '_' + me() && request.resource.data.owner != me()
        && request.resource.data.status == 'pending'
        && exists(/databases/$(database)/documents/premium/$(me()));
      allow update: if signedIn() && resource.data.owner == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['approved', 'denied'];
      allow delete: if signedIn() && me() in rid.split('_');
    }
    // Premium: sirf creator (admin) dete/hatate hain. User sirf apna dekh sakta hai.
    match /premium/{uid} {
      allow read: if signedIn() && (uid == me() || isAdmin());
      allow write: if isAdmin();
    }
    // Premium payment proof: user khud apna Razorpay payment_id bhejta hai (paisa receive hone ka record),
    // lekin ye khud se kabhi Premium nahi deta — sirf admin Razorpay dashboard me amount check karke
    // "premium/{uid}" alag se likhta hai. Isse koi devtools se fake "paid" bata ke Premium nahi le sakta.
    match /premiumRequests/{uid} {
      allow get: if signedIn() && (uid == me() || isAdmin());
      allow list: if signedIn() && isAdmin();
      allow create: if signedIn() && uid == me() && notBanned()
        && request.resource.data.paymentId is string && request.resource.data.paymentId.size() > 0 && request.resource.data.paymentId.size() <= 80
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 100000
        && request.resource.data.status == 'pending';
      allow delete: if isAdmin();
    }

    // Identity verification selfies: sirf apna submit kare; sirf apna + admin padh sakte hain; admin hi delete (review ke baad) karta hai.
    match /verifications/{uid} {
      allow get: if signedIn() && (uid == me() || isAdmin());
      allow list: if signedIn() && isAdmin();
      allow create, update: if signedIn() && uid == me() && notBanned()
        && request.resource.data.get('photo', '').size() <= 700000 && request.resource.data.get('photo', '').size() > 0
        && request.resource.data.status == 'pending';
      allow delete: if isAdmin();
    }
  }
}
